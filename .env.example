# 발행 타겟: Notion DB. 두 ID 모두 Notion 페이지 URL 끝 32자 hex.
# - Parent page = DB가 들어 있는 부모 Notion 페이지
# - DB          = 글이 실제로 쌓이는 데이터베이스 (inline 또는 standalone)
#
# 찾는 법: Notion에서 DB 우상단 ··· → Copy link → URL 마지막 hex 32자
#   예) https://www.notion.so/your-workspace/My-DB-abcdef0123456789abcdef0123456789
#                                                   └──────── DB ID ────────┘
NOTION_PARENT_PAGE_ID=
NOTION_DATABASE_ID=

# 제목 필드명. Notion DB의 title 속성명을 그대로. 한글이면 한글 그대로.
NOTION_DB_TITLE_FIELD=이름

# 선택: DB에 추가 속성 있으면 채우기. 빈 값이면 publisher가 해당 매핑 스킵.
NOTION_DB_STATUS_FIELD=
NOTION_DB_STATUS_DRAFT_VALUE=
NOTION_DB_CATEGORY_FIELD=
NOTION_DB_TAGS_FIELD=
